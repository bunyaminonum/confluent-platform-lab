# Copy to .env and fill in.  .env is git-ignored.

# --- Directory (profile: ldap) ---
LDAP_ORGANISATION=Confluent Lab
LDAP_DOMAIN=lab.local
LDAP_ADMIN_PASSWORD=<STRONG_RANDOM_PASSWORD>

# --- CyberArk Conjur (profile: conjur) ---
# CONJUR_DATA_KEY must be REGENERATED for every from-scratch install:
#   podman run --rm docker.io/cyberark/conjur data-key generate
CONJUR_DB_PASSWORD=<STRONG_RANDOM_PASSWORD>
CONJUR_DATA_KEY=<OUTPUT OF data-key generate>

# --- Monitoring (profile: monitoring) ---
GRAFANA_ADMIN_PASSWORD=<STRONG_RANDOM_PASSWORD>

# Prometheus runs inside a container and does not inherit the host's
# /etc/hosts, so the Confluent node names have to be mapped explicitly.
# Use the same names as inventory_hostname in ../ansible/hosts.yml.
CP_NODE1_NAME=cp-node1
CP_NODE1_IP=10.0.0.1
CP_NODE2_NAME=cp-node2
CP_NODE2_IP=10.0.0.2
CP_NODE3_NAME=cp-node3
CP_NODE3_IP=10.0.0.3
