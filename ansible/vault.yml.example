---
# Copy this to vault.yml, fill in the REAL values, then encrypt it:
#     cp vault.yml.example vault.yml
#     ansible-vault encrypt vault.yml
#
# vault.yml is git-ignored — never commit it.
#
# These passwords must exist in LDAP with the same values.
# ldap/set-passwords.sh generates them all and writes them to
# ldap/generated-passwords.txt; copy them from there.

# --- MDS bootstrap superuser ---
vault_mds_super_user_password: "CHANGEME"

# --- Account MDS uses to query the directory ---
# This is NOT a Kafka identity; it should hold read-only LDAP access.
vault_ldap_bind_password: "CHANGEME"

# --- Component service accounts ---
vault_kafka_broker_ldap_password: "CHANGEME"
vault_schema_registry_ldap_password: "CHANGEME"
vault_kafka_connect_ldap_password: "CHANGEME"
vault_kafka_rest_ldap_password: "CHANGEME"
vault_control_center_next_gen_ldap_password: "CHANGEME"

# --- Optional ---
vault_confluent_license_key: ""
