# Air-gapped package repository. The hostname in baseurl must match the
# cp_infra_host value in hosts.yml.
[confluent-local]
name=Confluent Platform (air-gap local)
baseurl=http://cp-node1:8080/confluent
enabled=1
gpgcheck=0

[os-local]
name=OS Packages (air-gap local)
baseurl=http://cp-node1:8080/os
enabled=1
gpgcheck=0
