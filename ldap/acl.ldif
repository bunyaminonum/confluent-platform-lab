# Grants the MDS bind account read access to the user and group subtrees.
#
# osixia/openldap ships a default ACL whose final rule is
#   to * by self read by dn="cn=admin,..." write by * none
# so every DN other than cn=admin gets *no* read access to the tree. A bind
# still succeeds (the userPassword rule allows `by anonymous auth`), which is
# why `ldapwhoami` passes, but any search returns "No such object (32)" —
# OpenLDAP hides entries the requester may not see rather than returning
# insufficientAccess.
#
# Without this file the Kafka broker's MDS binds as cn=ldap-bind-user, gets
# noSuchObject on its group search, never finishes initialising the RBAC
# authorizer, and blocks at "Waiting for all of the authorizer futures to be
# completed" until confluent.authorizer.init.timeout.ms (10 min) expires. The
# broker then aborts startup, port 8090 never opens, and cp-ansible fails on
# "Get Authorization Token from MDS".
#
# The bind account is granted read on ou=users and ou=groups only. Password
# hashes stay unreadable: the userPassword rule is matched first and gives the
# bind account `none`, leaving just the `by anonymous auth` needed to
# authenticate users by binding as them.
#
# Apply (adjust the base DN if you changed cp_ldap_base):
#   podman cp ldap/acl.ldif openldap:/tmp/
#   podman exec openldap ldapmodify -H ldapi:/// -Y EXTERNAL -f /tmp/acl.ldif
#
dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to * by dn.exact=gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth manage by * break
olcAccess: {1}to attrs=userPassword,shadowLastChange by self write by dn="cn=admin,dc=lab,dc=local" write by anonymous auth by * none
olcAccess: {2}to dn.subtree="ou=users,dc=lab,dc=local" by dn.exact="cn=ldap-bind-user,dc=lab,dc=local" read by self read by dn="cn=admin,dc=lab,dc=local" write by * none
olcAccess: {3}to dn.subtree="ou=groups,dc=lab,dc=local" by dn.exact="cn=ldap-bind-user,dc=lab,dc=local" read by self read by dn="cn=admin,dc=lab,dc=local" write by * none
olcAccess: {4}to * by self read by dn="cn=admin,dc=lab,dc=local" write by * none
